  {
    "key": "github",
    "title": "GitHub",
    "icon": "🐙",
    "description": "Repository statistics (GitHub public API).",
    "httpMethod": "GET",
    "urlTemplate": "https://api.github.com/repos/{repo}",
    "bodyTemplate": null,
    "headers": {
      "Accept": "application/vnd.github+json"
    },
    "inputs": [
      {
        "name": "repo",
        "label": "Repository (owner/name)",
        "type": "text",
        "required": true,
        "default": "dotnet/aspnetcore",
        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
      }
    ],
    "displayType": "stats",
    "displayConfig": {
      "heading": {
        "title": "full_name",
        "subtitle": "description"
      },
      "fields": [
        {
          "label": "Stars",
          "path": "stargazers_count",
          "format": "number"
        },
        {
          "label": "Forks",
          "path": "forks_count",
          "format": "number"
        },
        {
          "label": "Open issues",
          "path": "open_issues_count",
          "format": "number"
        },
        {
          "label": "Watchers",
          "path": "subscribers_count",
          "format": "number"
        },
        {
          "label": "Language",
          "path": "language"
        },
        {
          "label": "License",
          "path": "license.spdx_id"
        },
        {
          "label": "Last push",
          "path": "pushed_at",
          "format": "date"
        }
      ]
    },
    "cacheSeconds": 300
  },
  {
