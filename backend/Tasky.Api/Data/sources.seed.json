[
  {
    "key": "weather",
    "title": "Weather",
    "icon": "🌤",
    "description": "Live weather for any latitude and longitude (Open-Meteo, no key needed).",
    "httpMethod": "GET",
    "urlTemplate": "https://api.open-meteo.com/v1/forecast?latitude={latitude}&longitude={longitude}&current=temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m",
    "bodyTemplate": null,
    "headers": {},
    "inputs": [
      {
        "name": "latitude",
        "label": "Latitude",
        "type": "number",
        "required": true,
        "default": "28.61"
      },
      {
        "name": "longitude",
        "label": "Longitude",
        "type": "number",
        "required": true,
        "default": "77.21"
      }
    ],
    "displayType": "stats",
    "displayConfig": {
      "fields": [
        {
          "label": "Temperature",
          "path": "current.temperature_2m",
          "suffix": " °C"
        },
        {
          "label": "Feels like",
          "path": "current.apparent_temperature",
          "suffix": " °C"
        },
        {
          "label": "Humidity",
          "path": "current.relative_humidity_2m",
          "suffix": " %"
        },
        {
          "label": "Wind",
          "path": "current.wind_speed_10m",
          "suffix": " km/h"
        },
        {
          "label": "Observed at",
          "path": "current.time"
        }
      ]
    },
    "cacheSeconds": 300
  },
  {
    "key": "crypto",
    "title": "Crypto",
    "icon": "₿",
    "description": "Top coins by market cap (CoinGecko public API).",
    "httpMethod": "GET",
    "urlTemplate": "https://api.coingecko.com/api/v3/coins/markets?vs_currency={currency}&order=market_cap_desc&per_page=10&page=1&sparkline=false",
    "bodyTemplate": null,
    "headers": {},
    "inputs": [
      {
        "name": "currency",
        "label": "Currency",
        "type": "select",
        "required": true,
        "default": "usd",
        "options": [
          "usd",
          "inr",
          "eur"
        ]
      }
    ],
    "displayType": "list",
    "displayConfig": {
      "itemsPath": "",
      "title": "name",
      "subtitle": "symbol",
      "subtitleFormat": "upper",
      "value": {
        "path": "current_price",
        "format": "number"
      },
      "badge": {
        "path": "price_change_percentage_24h",
        "format": "percent",
        "tone": "signed"
      }
    },
    "cacheSeconds": 60
  },
  {
    "key": "currency",
    "title": "Currency",
    "icon": "💱",
    "description": "Exchange rates for a base currency (open.er-api.com).",
    "httpMethod": "GET",
    "urlTemplate": "https://open.er-api.com/v6/latest/{base}",
    "bodyTemplate": null,
    "headers": {},
    "inputs": [
      {
        "name": "base",
        "label": "Base currency",
        "type": "select",
        "required": true,
        "default": "USD",
        "options": [
          "USD",
          "INR",
          "EUR",
          "GBP",
          "JPY",
          "AUD"
        ]
      }
    ],
    "displayType": "list",
    "displayConfig": {
      "itemsPath": "rates",
      "entries": true,
      "limit": 20,
      "title": "key",
      "value": {
        "path": "value",
        "format": "number4"
      }
    },
    "cacheSeconds": 600
  },
  {
    "key": "countries",
    "title": "Countries",
    "icon": "🌍",
    "description": "Search countries by name (REST Countries).",
    "httpMethod": "GET",
    "urlTemplate": "https://restcountries.com/v3.1/name/{name}?fields=name,capital,region,population",
    "bodyTemplate": null,
    "headers": {},
    "inputs": [
      {
        "name": "name",
        "label": "Country name",
        "type": "text",
        "required": true,
        "default": "India",
        "pattern": "^[A-Za-z .'-]{2,60}$"
      }
    ],
    "displayType": "list",
    "displayConfig": {
      "itemsPath": "",
      "title": "name.common",
      "subtitle": "capital[0]",
      "value": {
        "path": "population",
        "format": "number",
        "suffix": " people"
      },
      "badge": {
        "path": "region"
      }
    },
    "cacheSeconds": 3600
  },
