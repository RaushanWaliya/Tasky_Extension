  {
    "key": "createpost",
    "title": "Create Post",
    "icon": "✍",
    "description": "Execute example: sends a POST request (JSONPlaceholder echoes it back, nothing is stored).",
    "httpMethod": "POST",
    "urlTemplate": "https://jsonplaceholder.typicode.com/posts",
    "bodyTemplate": "{\"title\":\"{title}\",\"body\":\"{body}\",\"userId\":{userId}}",
    "headers": {},
    "inputs": [
      {
        "name": "title",
        "label": "Title",
        "type": "text",
        "required": true,
        "default": "Hello from Tasky",
        "maxLength": 100
      },
      {
        "name": "body",
        "label": "Body",
        "type": "textarea",
        "required": true,
        "default": "Created through the Tasky extension.",
        "maxLength": 300
      },
      {
        "name": "userId",
        "label": "User id",
        "type": "number",
        "required": true,
        "default": "1",
        "pattern": "^[0-9]{1,4}$"
      }
    ],
    "displayType": "keyvalue",
    "displayConfig": {
      "fields": [
        {
          "label": "New post id",
          "path": "id"
        },
        {
          "label": "Title",
          "path": "title"
        },
        {
          "label": "Body",
          "path": "body"
        },
        {
          "label": "User id",
          "path": "userId"
        }
      ]
    },
    "cacheSeconds": 0
  }
]