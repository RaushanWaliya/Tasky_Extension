{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "SqlServer",
    "SeedFile": "Data/sources.seed.json"
  },

  "ConnectionStrings": {
    "TaskyDb": "Server=localhost;Database=TaskyDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Upstream": {
    "TimeoutSeconds": 15,
    "MaxResponseBytes": 2097152,
    "UserAgent": "TaskyExtension/1.0 (+https://bumblebot.tech)"
  },

  "Cors": {
    "AllowedOrigins": []
  }
}
